/* pages/PLANT_B_REPAIR/edit-todo/edit-todo.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  padding-bottom: 140rpx;
}

/* 头部样式 */
.header {
  background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
  padding: 80rpx 40rpx 60rpx;
  border-radius: 0 0 40rpx 40rpx;
  box-shadow: 0 4rpx 24rpx rgba(59, 130, 246, 0.3);
  position: relative;
  z-index: 1;
}

.header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-left {
  flex: 0 0 auto;
}

.back-btn {
  font-size: 46rpx;
  color: white;
  font-weight: 300;
  opacity: 0.9;
}

.header-title-section {
  flex: 1;
  text-align: center;
}

.header-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: white;
  margin-bottom: 8rpx;
}

.header-subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  opacity: 0.9;
}

.header-right {
  flex: 0 0 auto;
}

.save-btn {
  font-size: 28rpx;
  color: white;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.2);
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(10rpx);
}

/* 表单容器 */
.form-container {
  height: calc(100vh - 280rpx);
  padding: 30rpx 40rpx 0;
  box-sizing: border-box;
}

/* 表单卡片 */
.form-card {
  background: white;
  border-radius: 24rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  border: 1rpx solid #e2e8f0;
  overflow: hidden;
}

.card-header {
  padding: 40rpx 40rpx 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
  display: block;
  margin-bottom: 20rpx;
}

.card-line {
  height: 2rpx;
  background: linear-gradient(90deg, #3b82f6 0%, transparent 100%);
  border-radius: 1rpx;
}

.form-content {
  padding: 0 40rpx 40rpx;
}

/* 表单组 */
.form-group {
  margin-bottom: 36rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #334155;
  margin-bottom: 20rpx;
}

.form-tips {
  font-size: 24rpx;
  color: #94a3b8;
  margin-bottom: 16rpx;
}

/* 输入框样式 */
.form-input {
  width: 100%;
  font-size: 28rpx;
  padding: 28rpx 32rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  box-sizing: border-box;
  background: #f8fafc;
  color: #1e293b;
  transition: all 0.3s ease;
}

.form-input:focus {
  border-color: #3b82f6;
  background: white;
  box-shadow: 0 0 0 3rpx rgba(59, 130, 246, 0.1);
}

.form-input.disabled {
  background: #f1f5f9;
  color: #94a3b8;
  border-color: #e2e8f0;
  opacity: 0.8;
}

.placeholder {
  color: #94a3b8;
}

/* 下拉选择器 */
.form-picker {
  width: 100%;
  font-size: 28rpx;
  padding: 28rpx 32rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  box-sizing: border-box;
  background: #f8fafc;
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: all 0.3s ease;
}

.form-picker:active {
  border-color: #3b82f6;
  background: white;
  box-shadow: 0 0 0 3rpx rgba(59, 130, 246, 0.1);
}

.picker-text {
  color: #1e293b;
}

.picker-placeholder {
  color: #94a3b8;
}

.picker-icon {
  font-size: 24rpx;
  color: #64748b;
}

/* 文本域 */
.form-textarea {
  width: 100%;
  font-size: 28rpx;
  padding: 28rpx 32rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  box-sizing: border-box;
  background: #f8fafc;
  color: #1e293b;
  min-height: 200rpx;
  line-height: 1.6;
  transition: all 0.3s ease;
}

.form-textarea:focus {
  border-color: #3b82f6;
  background: white;
  box-shadow: 0 0 0 3rpx rgba(59, 130, 246, 0.1);
}

/* 创建时间显示样式 */
.create-time-display {
  width: 100%;
  font-size: 28rpx;
  padding: 28rpx 32rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  box-sizing: border-box;
  background: #f8fafc;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.create-time-icon {
  font-size: 32rpx;
  color: #64748b;
}

.create-time-text {
  color: #1e293b;
  font-weight: 500;
}

/* 图片上传 */
.image-upload {
  margin-top: 10rpx;
}

.upload-tips {
  font-size: 24rpx;
  color: #94a3b8;
  margin-bottom: 24rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.image {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(239, 68, 68, 0.9);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 300;
  z-index: 2;
}

.upload-btn {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #cbd5e1;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f8fafc;
  transition: all 0.3s ease;
}

.upload-btn:active {
  background: #f1f5f9;
  border-color: #3b82f6;
}

.upload-icon {
  font-size: 56rpx;
  color: #64748b;
  margin-bottom: 12rpx;
  font-weight: 300;
}

.upload-text {
  font-size: 24rpx;
  color: #64748b;
}

/* 底部空间 */
.footer-space {
  height: 40rpx;
}

/* 底部操作栏 */
.footer-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 30rpx 40rpx 50rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
}

.save-btn-large {
  width: 100%;
  background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
  color: white;
  border: none;
  border-radius: 16rpx;
  padding: 30rpx;
  font-size: 32rpx;
  font-weight: 600;
  transition: all 0.3s ease;
}

.save-btn-large:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 动画效果 */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.form-card {
  animation: fadeInUp 0.5s ease-out forwards;
}

.form-card:nth-child(2) {
  animation-delay: 0.1s;
}

.form-card:nth-child(3) {
  animation-delay: 0.2s;
}

/* 特殊样式 */
.form-input.disabled {
  cursor: not-allowed;
}