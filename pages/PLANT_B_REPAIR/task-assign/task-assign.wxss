/* pages/PLANT_B_REPAIR/task-assign/task-assign.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f6fa;
}

/* 头部样式 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: white;
  border-bottom: 1rpx solid #eee;
}

.header-left, .header-right {
  width: 120rpx;
}

.back-btn {
  font-size: 36rpx;
  color: #333;
  font-weight: bold;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.logout-btn {
  font-size: 28rpx;
  color: #FF3B30;
}

/* 统计概览 */
.stats-overview {
  display: flex;
  justify-content: space-around;
  padding: 30rpx;
  background: white;
  margin: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.stat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-number {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #666;
}

/* 任务类型切换按钮 */
.task-type-tabs {
  display: flex;
  background: white;
  margin: 0 20rpx;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.tab-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 10rpx;
  border-radius: 12rpx;
  transition: all 0.3s ease;
  position: relative;
}

.tab-btn.active {
  background: #f0f8ff;
  border: 2rpx solid #007AFF;
}

.tab-btn:active {
  background: #f0f8ff;
}

.tab-icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
}

.tab-text {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.tab-btn.active .tab-text {
  color: #007AFF;
  font-weight: bold;
}

.tab-badge {
  position: absolute;
  top: 10rpx;
  right: 20rpx;
  background: #FF3B30;
  color: white;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  min-width: 24rpx;
  text-align: center;
}

/* 标签页内容 */
.tab-content {
  padding: 0 20rpx 20rpx;
}

.assigned-header, .in-progress-header, .completed-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 30rpx 0 20rpx;
  padding: 0 10rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-count {
  font-size: 26rpx;
  color: #666;
}

/* 批量操作 */
.batch-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: white;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.batch-select {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.select-all-text {
  font-size: 28rpx;
  color: #007AFF;
  font-weight: 500;
}

.selected-count {
  font-size: 24rpx;
  color: #666;
}

.batch-assign-btn {
  background: #007AFF;
  color: white;
  border: none;
  border-radius: 20rpx;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
}

.batch-assign-btn[disabled] {
  background: #ccc;
  color: #999;
}

/* 任务列表 */
.task-list {
  margin-bottom: 20rpx;
}

/* 任务卡片 */
.task-card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.task-card.unassigned {
  border-left: 8rpx solid #FF9500;
}

.task-card.assigned {
  border-left: 8rpx solid #FF9500;
}

.task-card.in-progress {
  border-left: 8rpx solid #007AFF;
}

.task-card.completed {
  border-left: 8rpx solid #34C759;
}

/* 任务多选框 */
.task-checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ddd;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 10rpx;
  flex-shrink: 0;
}

.task-checkbox.checked {
  background: #007AFF;
  border-color: #007AFF;
}

.checkmark {
  color: white;
  font-size: 22rpx;
  font-weight: bold;
}

/* 任务内容 */
.task-content {
  flex: 1;
  min-width: 0;
  padding-right: 10rpx;
}

.task-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 15rpx;
  flex-wrap: wrap;
}

.task-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  margin-right: 15rpx;
  line-height: 1.4;
  word-break: break-word;
  margin-bottom: 10rpx;
}

/* 优先级操作区域 */
.priority-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 5rpx;
}

.priority-badge {
  font-size: 20rpx;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.priority-badge.urgent {
  background: #ffece5;
  color: #ff6b35;
}

.priority-badge.normal {
  background: #e8f0fe;
  color: #1a73e8;
}

.priority-change-btn {
  font-size: 20rpx;
  color: #007AFF;
  text-decoration: underline;
  padding: 4rpx 8rpx;
}

/* 徽章组 */
.task-badges {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  align-items: flex-end;
  margin-top: 5rpx;
}

.technician-badge {
  font-size: 20rpx;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
  color: #666;
  white-space: nowrap;
}

/* 任务状态徽章 */
.task-state-badge {
  font-size: 20rpx;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  white-space: nowrap;
}

.task-state-badge.started {
  background: #e8f4ff;
  color: #007AFF;
  border: 1rpx solid #007AFF;
}

.task-state-badge.assigned {
  background: #fff4e5;
  color: #FF9500;
  border: 1rpx solid #FF9500;
}

/* 任务详细信息组 */
.task-detail-group {
  margin-bottom: 15rpx;
  padding: 15rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  border: 1rpx solid #eee;
}

.detail-row {
  display: flex;
  margin-bottom: 8rpx;
  font-size: 26rpx;
  line-height: 1.4;
}

.detail-row:last-child {
  margin-bottom: 0;
}

.detail-label {
  color: #666;
  font-weight: 500;
  width: 120rpx;
  flex-shrink: 0;
}

.detail-value {
  color: #333;
  flex: 1;
  word-break: break-word;
}

.task-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 15rpx;
  line-height: 1.4;
  word-break: break-word;
  padding: 0 5rpx;
}

/* 图片显示样式 */
.task-images {
  margin-top: 15rpx;
  margin-bottom: 15rpx;
  border-top: 1rpx solid #eee;
  padding-top: 15rpx;
}

.images-title {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
  font-weight: bold;
}

.images-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.task-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.1);
  border: 1rpx solid #eee;
  overflow: hidden;
}

.task-image:active {
  opacity: 0.8;
}

/* 任务底部信息 */
.task-footer {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 10rpx;
  padding-top: 15rpx;
  border-top: 1rpx solid #f0f0f0;
}

.task-creator {
  font-size: 22rpx;
  color: #1a73e8;
}

.task-time {
  font-size: 22rpx;
  color: #999;
}

.task-status {
  font-size: 22rpx;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  white-space: nowrap;
  align-self: flex-start;
}

.task-status.assigned {
  background: #fff4e5;
  color: #FF9500;
}

.task-status.in-progress {
  background: #e8f4ff;
  color: #007AFF;
}

.task-status.completed {
  background: #e7f7ed;
  color: #34a853;
}

/* 任务操作按钮 */
.task-actions {
  flex-shrink: 0;
  margin-left: 10rpx;
}

.action-btn {
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
  border: none;
  white-space: nowrap;
}

.assign-btn {
  background: #007AFF;
  color: white;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  text-align: center;
  background: white;
  border-radius: 16rpx;
  margin-top: 20rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #999;
}

/* 模态框 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: white;
  border-radius: 20rpx;
  width: 600rpx;
  max-width: 90%;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
}

.modal-body {
  padding: 30rpx;
}

.modal-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 30rpx;
  display: block;
}

/* 优先级选择列表 */
.priority-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.priority-item {
  display: flex;
  align-items: center;
  padding: 25rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.priority-item:active {
  background: #f8f9fa;
  border-color: #007AFF;
}

.priority-color {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.priority-info {
  flex: 1;
}

.priority-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 5rpx;
}

.priority-select {
  font-size: 28rpx;
  color: #007AFF;
  font-weight: bold;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.priority-item:active .priority-select {
  opacity: 1;
}

/* 维修员选择列表 */
.technician-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.technician-item {
  display: flex;
  align-items: center;
  padding: 25rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.technician-item:active {
  background: #f8f9fa;
  border-color: #007AFF;
}

.technician-avatar {
  font-size: 50rpx;
  margin-right: 20rpx;
}

.technician-info {
  flex: 1;
}

.technician-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 5rpx;
}

.technician-status {
  font-size: 22rpx;
  color: #666;
}

.technician-select {
  font-size: 28rpx;
  color: #007AFF;
  font-weight: bold;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.technician-item:active .technician-select {
  opacity: 1;
}