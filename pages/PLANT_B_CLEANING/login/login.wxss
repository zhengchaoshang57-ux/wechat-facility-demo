/* pages/PLANT_B_CLEANING/login/login.wxss */
.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 30rpx;
  position: relative;
  overflow: hidden;
}

/* 返回按钮样式 */
.back-button {
  position: absolute;
  top: 40rpx;
  left: 30rpx;
  z-index: 10;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50rpx;
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  transition: all 0.3s ease;
}

.back-button:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.95);
}

.back-icon {
  font-size: 36rpx;
  color: white;
  font-weight: bold;
  margin-right: 10rpx;
}

.back-text {
  font-size: 28rpx;
  color: white;
  font-weight: 500;
}

/* 背景装饰 */
.background-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.decoration-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.circle-1 {
  width: 200rpx;
  height: 200rpx;
  top: -100rpx;
  right: -100rpx;
}

.circle-2 {
  width: 150rpx;
  height: 150rpx;
  bottom: 20%;
  left: -75rpx;
}

.circle-3 {
  width: 100rpx;
  height: 100rpx;
  top: 30%;
  left: 10%;
}

/* 欢迎区域 */
.welcome-section {
  text-align: center;
  margin-bottom: 80rpx;
  margin-top: 140rpx;
}

.app-logo {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  display: block;
}

.app-name {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 20rpx;
}

.welcome-text {
  display: block;
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 角色选择 */
.role-selection {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  margin-bottom: 60rpx;
}

.role-card {
  background: white;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.15);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.role-card:active {
  transform: translateY(4rpx);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.1);
}

.role-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
}

.role-card.admin::before {
  background: linear-gradient(90deg, #ff6b6b, #ff8e8e);
}

.role-card.dispather::before {
  background: linear-gradient(90deg, #4ecdc4, #6de0d7);
}

.role-card.technician::before {
  background: linear-gradient(90deg, #45b7d1, #67c9e0);
}

.role-icon {
  font-size: 80rpx;
  text-align: center;
  margin-bottom: 20rpx;
  display: block;
}

.role-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 10rpx;
}

.role-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  text-align: center;
  margin-bottom: 30rpx;
}

.role-features {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.feature-item {
  font-size: 24rpx;
  color: #888;
  text-align: center;
}

/* 底部信息 */
.footer {
  text-align: center;
  padding: 0 20rpx;
}

.footer-text {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 15rpx;
}

.footer-hint {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 添加点击动画 */
@keyframes cardClick  {
  0% { transform: scale(1); }
  50% { transform: scale(0.98); }
  100% { transform: scale(1); }
}

.role-card:active {
  animation: cardClick 0.3s ease;
}