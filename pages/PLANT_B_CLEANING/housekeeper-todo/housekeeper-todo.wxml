<!--pages/PLANT_B_CLEANING/housekeeper-todo/housekeeper-todo.wxml-->
<view class="container">
  <!-- 顶部标题栏 -->
  <view class="header">
    <view class="header-left">
      <text class="back-btn" bindtap="goBack">←</text>
    </view>
    <text class="header-title">我的任务</text>
    <view class="header-right">
      <text class="logout-btn" bindtap="logout">退出</text>
    </view>
  </view>

  <!-- 统计信息 -->
  <view class="stats">
    <view class="stat-item">
      <text class="stat-number">{{pendingCount}}</text>
      <text class="stat-label">待处理</text>
    </view>
    <view class="stat-item">
      <text class="stat-number">{{inProgressCount}}</text>
      <text class="stat-label">进行中</text>
    </view>
    <view class="stat-item">
      <text class="stat-number">{{completedCount}}</text>
      <text class="stat-label">已完成</text>
    </view>
    <view class="stat-item">
      <text class="stat-number">{{unfinishedCount}}</text>
      <text class="stat-label">未完成</text>
    </view>
  </view>

  <!-- 任务列表 -->
  <scroll-view class="task-list" scroll-y="true" style="height: {{scrollHeight}}px;" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onPullDownRefresh">
    
    <!-- 待处理任务 -->
    <view class="section-title" wx:if="{{pendingTasks.length > 0}}">待处理任务 ({{pendingTasks.length}})</view>
    <block wx:for="{{pendingTasks}}" wx:key="id">
      <view class="task-card pending">
        <view class="task-header">
          <text class="task-title">{{item.title}}</text>
          <view class="task-badges">
            <text class="priority-badge {{item.priority === 'high' ? 'urgent' : 'normal'}}">
              {{item.priority === 'high' ? '紧急' : '普通'}}
            </text>
          </view>
        </view>
        
        <view class="task-content">
          <!-- 显示三个新增字段 -->
          <view class="task-info-group">
            <text class="task-info">来源：{{item.source || '未选择'}}</text>
            <text class="task-info">
              问题区域：
              <text wx:if="{{item.problemArea === '其他'}}">{{item.otherAreaDescription || '其他'}}</text>
              <text wx:else>{{item.problemArea || '未选择'}}</text>
            </text>
            <text class="task-info">问题：{{item.problem || '未选择'}}</text>
          
          <!-- 显示子区域 -->
            <text class="task-info" wx:if="{{item.subArea}}">
              子区域：
              <text wx:if="{{item.subArea === '其他'}}">{{item.otherSubAreaDescription || '其他'}}</text>
              <text wx:else>{{item.subArea}}</text>
            </text>
            <!-- 显示门牌号 -->
            <text class="task-info" wx:if="{{item.doorNumber}}">门牌号：{{item.doorNumber}}</text>
          </view>
          
          <text class="task-desc">{{item.description || '无描述'}}</text>
          
          <!-- 显示图片 -->
          <view class="task-images" wx:if="{{item.images && item.images.length > 0}}">
            <view class="images-title">相关图片 ({{item.images.length}}张)</view>
            <view class="images-list">
              <block wx:for="{{item.images}}" wx:key="index">
                <image class="task-image" 
                       src="{{item}}" 
                       mode="aspectFill" 
                       bindtap="previewImage" 
                       data-id="{{item.id}}" 
                       data-index="{{index}}"></image>
              </block>
            </view>
          </view>
          
          <view class="task-footer">
            <text class="task-creator">创建人：{{item.creator || '未知'}}</text>
            <text class="task-time">创建时间：{{item.estimatedTime}}</text>
            <text class="task-assignee">分配员：{{item.createdBy || '系统'}}</text>
          </view>
        </view>
        
        <view class="task-actions">
          <button class="action-btn start-btn" bindtap="startTask" data-id="{{item.id}}">开始处理</button>
        </view>
      </view>
    </block>

    <!-- 进行中任务 -->
    <view class="section-title" wx:if="{{inProgressTasks.length > 0}}">进行中任务 ({{inProgressTasks.length}})</view>
    <block wx:for="{{inProgressTasks}}" wx:key="id">
      <view class="task-card in-progress">
        <view class="task-header">
          <text class="task-title">{{item.title}}</text>
          <view class="task-badges">
            <text class="priority-badge {{item.priority === 'high' ? 'urgent' : 'normal'}}">
              {{item.priority === 'high' ? '紧急' : '普通'}}
            </text>
          </view>
        </view>
        
        <view class="task-content">
          <!-- 显示新增字段 -->
          <view class="task-info-group">
            <text class="task-info">来源：{{item.source || '未选择'}}</text>
            <text class="task-info">
              问题区域：
              <text wx:if="{{item.problemArea === '其他'}}">{{item.otherAreaDescription || '其他'}}</text>
              <text wx:else>{{item.problemArea || '未选择'}}</text>
            </text>
            <text class="task-info">问题：{{item.problem || '未选择'}}</text>
            <!-- 显示子区域 -->
            <text class="task-info"wx:if="{{item.subArea}}">
              子区域：
              <text wx:if="{{item.subArea === '其他'}}">{{item.otherSubAreaDescription || '其他'}}</text>
              <text wx:else>{{item.subArea}}</text>
            </text>
            <!-- 显示门牌号 -->
            <text class="task-info" wx:if="{{item.doorNumber}}">门牌号：{{item.doorNumber}}</text>
          </view>
          
          <text class="task-desc">{{item.description || '无描述'}}</text>
          
          <!-- 显示图片 -->
          <view class="task-images" wx:if="{{item.images && item.images.length > 0}}">
            <view class="images-title">相关图片 ({{item.images.length}}张)</view>
            <view class="images-list">
              <block wx:for="{{item.images}}" wx:key="index">
                <image class="task-image" 
                       src="{{item}}" 
                       mode="aspectFill" 
                       bindtap="previewImage" 
                       data-id="{{item.id}}" 
                       data-index="{{index}}"></image>
              </block>
            </view>
          </view>
          
          <view class="task-footer">
            <text class="task-creator">创建人：{{item.creator || '未知'}}</text>
            <text class="task-time" wx:if="{{item.startTime}}">开始时间：{{item.startTime}}</text>
            <text class="task-time">创建时间：{{item.estimatedTime}}</text>
          </view>
        </view>
        
        <view class="task-actions">
          <button class="action-btn unfinished-btn"
                  bindtap="markAsUnfinished" 
                  data-id="{{item.id}}"
                  data-index="{{index}}">标记未完成</button>
          <button class="action-btn complete-btn" bindtap="completeTask" data-id="{{item.id}}">标记完成</button>
        </view>
      </view>
    </block>
    <!-- 已完成任务 -->
    <view class="section-title" wx:if="{{completedTasks.length > 0}}">已完成任务 ({{completedTasks.length}})</view>
    <block wx:for="{{completedTasks}}" wx:key="id">
      <view class="task-card completed">
        <view class="task-header">
          <text class="task-title">{{item.title}}</text>
          <view class="task-badges">
            <text class="priority-badge {{item.priority === 'high' ? 'urgent' : 'normal'}}">
              {{item.priority === 'high' ? '紧急' : '普通'}}
            </text>
          </view>
        </view>
        <view class="task-content">
          <!-- 显示新增字段 -->
          <view class="task-info-group">
            <text class="task-info">来源：{{item.source || '未选择'}}</text>
            <text class="task-info">
              问题区域：
              <text wx:if="{{item.problemArea === '其他'}}">{{item.otherAreaDescription || '其他'}}</text>
              <text wx:else>{{item.problemArea || '未选择'}}</text>
            </text>
            <text class="task-info">问题：{{item.problem || '未选择'}}</text>
            <!-- 显示子区域 -->
            <text class="task-info" wx:if="{{item.subArea}}">
              子区域：
              <text wx:if="{{item.subArea === '其他'}}">{{item.otherSubAreaDescription || '其他'}}</text>
              <text wx:else>{{item.subArea}}</text>
            </text>
            <!-- 显示门牌号 -->
            <text class="task-info" wx:if="{{item.doorNumber}}">门牌号：{{item.doorNumber}}</text>
          </view>
          
          <text class="task-desc">{{item.description || '无描述'}}</text>
          
          <!-- 显示图片 -->
          <view class="task-images" wx:if="{{item.images && item.images.length > 0}}">
            <view class="images-title">原始图片 ({{item.images.length}}张)</view>
            <view class="images-list">
              <block wx:for="{{item.images}}" wx:key="index">
                <image class="task-image" 
                       src="{{item}}" 
                       mode="aspectFill" 
                       bindtap="previewImage" 
                       data-id="{{item.id}}" 
                       data-index="{{index}}"></image>
              </block>
            </view>
          </view>
          
          <!-- 显示完成时上传的图片 -->
          <view class="task-images" wx:if="{{item.completedImages && item.completedImages.length > 0}}">
            <view class="images-title">完成时上传的图片({{item.completedImages.length}}张)</view>
            <view class="images-list">
              <block wx:for="{{item.completedImages}}" wx:key="index">
                <image class="task-image"
                       src="{{item}}"
                       mode="aspectFill"
                       bindtap="previewImage"
                       data-id="{{item.id}}"
                       data-index="{{index}}"
                       data-type="completedImages"></image>
              </block>
            </view>
          </view>

          <view class="task-footer">
            <text class="task-creator">创建人：{{item.creator || '未知'}}</text>
            <text class="task-time" wx:if="{{item.startTime}}">开始时间：{{item.startTime}}</text>
            <text class="task-time" wx:if="{{item.completedTime}}">完成时间：{{item.completedTime}}</text>
          </view>
        </view>
        
        <view class="task-actions">
          <text class="completed-text">任务已完成</text>
        </view>
      </view>
    </block>

    <!-- 未完成任务 -->
    <view class="section-title" wx:if="{{unfinishedTasks.length > 0}}">未完成任务 ({{unfinishedTasks.length}})</view>
    <block wx:for="{{unfinishedTasks}}" wx:key="id">
      <view class="task-card unfinished">
        <view class="task-header">
          <text class="task-title">{{item.title}}</text>
          <view class="task-badges">
            <text class="priority-badge {{item.priority === 'high' ? 'urgent' : 'normal'}}">
              {{item.priority === 'high' ? '紧急' : '普通'}}
            </text>
            <text class="unfinished-badge">未完成</text>
          </view>
        </view>
        
        <view class="task-content">
          <!-- 显示新增字段 -->
          <view class="task-info-group">
            <text class="task-info">来源：{{item.source || '未选择'}}</text>
            <text class="task-info">
              问题区域：
              <text wx:if="{{item.problemArea === '其他'}}">{{item.otherAreaDescription || '其他'}}</text>
              <text wx:else>{{item.problemArea || '未选择'}}</text>
            </text>
            <text class="task-info">问题：{{item.problem || '未选择'}}</text>
            <!-- 显示子区域 -->
            <text class="task-info" wx:if="{{item.subArea}}">
              子区域：
              <text wx:if="{{item.subArea === '其他'}}">{{item.otherSubAreaDescription || '其他'}}</text>
              <text wx:else>{{item.subArea}}</text>
            </text>
            <!-- 显示门牌号 -->
            <text class="task-info" wx:if="{{item.doorNumber}}">门牌号：{{item.doorNumber}}</text>
          </view>
          
          <text class="task-desc">{{item.description || '无描述'}}</text>
          
          <!-- 显示图片 -->
          <view class="task-images" wx:if="{{item.images && item.images.length > 0}}">
            <view class="images-title">相关图片 ({{item.images.length}}张)</view>
            <view class="images-list">
              <block wx:for="{{item.images}}" wx:key="index">
                <image class="task-image" 
                       src="{{item}}" 
                       mode="aspectFill" 
                       bindtap="previewImage" 
                       data-id="{{item.id}}" 
                       data-index="{{index}}"></image>
              </block>
            </view>
          </view>
          
          <view class="task-footer">
            <text class="task-creator">创建人：{{item.creator || '未知'}}</text>
            <text class="task-time" wx:if="{{item.unfinishedTime}}">未完成时间：{{item.unfinishedTime}}</text>
            <text class="task-time">创建时间：{{item.estimatedTime}}</text>
          </view>
          <view class="unfinished-reason" wx:if="{{item.unfinishedReason}}">
            <text class="reason-label">未完成原因:</text>
            <text class="reason-text">{{item.unfinishedReason}}</text>
          </view>
        </view>
        
        <view class="task-actions">
          <text class="unfinished-text">任务未完成</text>
        </view>
      </view>
    </block>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{totalCount === 0}}">
      <view class="empty-icon">📋</view>
      <text class="empty-text">暂无任务</text>
      <text class="empty-desc">当前没有分配给您的任务</text>
    </view>
  </scroll-view>

  <!-- 上传图片弹窗 -->
  <view class="modal-overlay" wx:if="{{showUploadModal}}"catchtap="hideUploadModalFunc">
    <view class="upload-modal" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">上传完成图片</text>
        <text class="modal-close" bindtap="hideUploadModalFunc">❌</text>
      </view>

      <view class="modal-content">
        <text class="upload-tip">请上传任务完成后的图片（最多9张）</text>

        <!-- 已选择的图片 -->
        <view class="selected-images">
          <block wx:for="{{taskImages}}" wx:key="index">
            <view class="image-item">
              <image class="selected-image" src="{{item.path}}" mode="aspectFill"></image>
              <view class="image-delete" bindtap="deleteImage" data-index="{{index}}">❌</view>
            </view>
          </block>

          <!-- 添加图片按钮 -->
          <view class="add-image-btn" wx:if="{{taskImages.length < 9}}" bindtap="chooseImages">
            <text class="add-icon">+</text>
            <text class="add-text">添加图片</text>
            <text class="image-count">{{taskImages.length}}/9</text>
          </view>
        </view>

        <!-- 上传进度 -->
        <view class="upload-progress" wx:if="{{isUploading}}">
          <view class="progress-bar">
            <view class="progress-fill" style="width: {{uploadProgress}}%"></view>
          </view>
          <text class="progress-text">{{uploadProgress}}%</text>
        </view>

        <view class="upload-actions">
          <button class="btn-cancel" bindtap="hideUploadModalFunc" disabled="{{isUploading}}">取消</button>
          <button class="btn-confirm" bindtap="uploadAndComplete" disabled="{{isUploading}}">
            {{isUploading ? '上传中...' : '确认完成'}}
          </button>
        </view>
      </view>
    </view>
  </view>
</view>