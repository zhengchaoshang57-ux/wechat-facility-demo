/* pages/PLANT_B_CLEANING/todo/todo.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: white;
  border-bottom: 1rpx solid #eee;
  flex-shrink: 0;
}

.header-left, .header-right {
  width: 80rpx;
}

.back-btn {
  font-size: 36rpx;
  color: #1a73e8;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.filter-btn {
  font-size: 28rpx;
  color: #1a73e8;
}

.stats {
  display: flex;
  justify-content: space-around;
  background: white;
  padding: 30rpx 0;
  margin-bottom: 20rpx;
  flex-shrink: 0;
}

.stat-item {
  text-align: center;
}

.stat-number {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #1a73e8;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #666;
}

.todo-list {
  flex: 1;
  padding: 0 20rpx;
  box-sizing: border-box;
  height: 100%;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin: 25rpx 0 15rpx;
  padding-left: 10rpx;
  border-left: 6rpx solid #1a73e8;
}

.todo-item {
  background: white;
  border-radius: 12rpx;
  padding: 25rpx;
  margin-bottom: 15rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.todo-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.todo-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  margin-right: 15rpx;
  line-height: 1.4;
  word-break: break-word;
}

.todo-status {
  font-size: 22rpx;
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.todo-status.normal {
  background: #e8f0fe;
  color: #1a73e8;
}

.todo-status.inprogress {
  background: #fff3e0;
  color: #ff9800;
}

/* 信息组样式 */
.todo-info-group {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.todo-info {
  font-size: 22rpx;
  color: #555;
  background: #f8f9fa;
  padding: 6rpx 12rpx;
  border-radius: 16rpx;
  border: 1rpx solid #eee;
}

.todo-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 15rpx;
  line-height: 1.4;
  word-break: break-word;
}

/* 图片显示样式 */
.todo-images {
  margin-bottom: 15rpx;
  border-top: 1rpx solid #eee;
  padding-top: 15rpx;
}

.images-title {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
  font-weight: bold;
}

.images-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.todo-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
  border: 1rpx solid #eee;
  overflow: hidden;
}

.todo-image:active {
  opacity: 0.8;
}

.todo-footer {
  display: flex;
  justify-content: space-between;
  margin-bottom: 18rpx;
  flex-wrap: wrap;
}

.todo-time, .todo-assignee {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 5rpx;
}

.todo-actions {
  display: flex;
  justify-content: space-between;
  gap: 8rpx;
}

.action-btn {
  flex: 1;
  border-radius: 40rpx;
  font-size: 22rpx; 
  padding: 12rpx 0;
  white-space: nowrap;
  text-align: center;
  line-height: 1.2;
  min-height: auto;
}

.action-btn.secondary {
  background: white;
  color: #1a73e8;
  border: 1rpx solid #1a73e8;
}

.action-btn.delete {
  background: white;
  color: #ff4444;
  border: 1rpx solid #ff4444;
}

.action-btn.secondary:active {
  background: #f0f7ff;
}

.action-btn.delete:active {
  background: #ffece5;
}

.empty-state {
  text-align: center;
  padding: 80rpx 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 25rpx;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
}

.todo-creator {
  font-size: 22rpx;
  color: #1a73e8;
  margin-bottom: 5rpx;
  flex-basis: 100%;
}

/* 问题分类单独显示样式 */
.todo-problem-type-section {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  padding: 8rpx 12rpx;
  background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
  border-radius: 12rpx;
  border-left: 4rpx solid #3b82f6;
}

.problem-type-label {
  display: flex;
  align-items: center;
  margin-right: 12rpx;
  font-size: 24rpx;
  color: #0369a1;
  font-weight: 600;
}

.label-icon {
  margin-right: 6rpx;
  font-size: 26rpx;
}

.problem-type-value {
  flex: 1;
}

.problem-type-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  background: white;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #1d4ed8;
  font-weight: 600;
  border: 1rpx solid #3b82f6;
  box-shadow: 0 2rpx 6rpx rgba(59, 130, 246, 0.1);
}