          <!-- 如果是"其他"子区域，显示其他描述 -->
          <text class="record-info" wx:if="{{item.subArea}}">子区域：{{item.subArea === '其他' ? item.otherSubAreaDescription : item.subArea}}</text>
          <text class="record-info" wx:if="{{item.doorNumber}}">门牌号：{{item.doorNumber}}</text>
        </view>
        
        <!-- 统一的时间信息区域 -->
        <view class="time-info-section">
          <view class="time-info-row">
            <text class="time-label">创建时间：</text>
            <text class="time-value">{{item.createTime || '无'}}</text>
          </view>
          <view class="time-info-row" wx:if="{{item.startTime}}">
            <text class="time-label">开始时间：</text>
            <text class="time-value">{{item.startTime}}</text>
          </view>
          <view class="time-info-row unfinished-time">
            <text class="time-label">未完成时间：</text>
            <text class="time-value">{{item.unfinishedTime}}</text>
          </view>
        </view>
        
        <text class="record-desc">描述：{{item.description}}</text>
        
        <!-- 显示图片 -->
        <view class="record-images" wx:if="{{item.images && item.images.length > 0}}">
          <view class="images-title">相关图片 ({{item.images.length}}张)</view>
          <view class="images-list">
            <block wx:for="{{item.images}}" wx:key="index">
              <image class="record-image" 
                     src="{{item}}" 
                     mode="aspectFill" 
                     bindtap="previewImage" 
                     data-id="{{item.id}}" 
                     data-index="{{index}}"></image>
            </block>
          </view>
        </view>
        
        <!-- 人员信息 -->
        <view class="people-info-section">
          <view class="people-info-row">
            <text class="people-label">创建人：</text>
            <text class="people-value">{{item.creator}}</text>
          </view>
          <view class="people-info-row">
            <text class="people-label">保洁员：</text>
            <text class="people-value">{{item.assignee}}</text>
          </view>
        </view>
        
        <!-- 未完成原因 -->
        <view class="unfinished-reason" wx:if="{{item.unfinishedReason}}">
          <text class="reason-label">未完成原因:</text>
          <text class="reason-text">{{item.unfinishedReason}}</text>
        </view>
      </view>
    </block>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{totalCount === 0}}">
    <view class="empty-icon">📊</view>
    <text class="empty-text">暂无历史记录</text>
    <text class="empty-desc">完成任务后，记录将显示在这里</text>
  </view>
</view>