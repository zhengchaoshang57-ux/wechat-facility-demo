          <text class="record-info" wx:if="{{item.subArea}}">子区域：{{item.subArea === '其他' ? item.otherSubAreaDescription : item.subArea}}</text>
          <text class="record-info" wx:if="{{item.doorNumber}}">门牌号：{{item.doorNumber}}</text>
