          <text class="record-info">问题区域：{{item.problemArea === '其他' ? item.otherAreaDescription : item.problemArea}}</text>
          <text class="record-info">问题：{{item.problem}}</text>
          <text class="record-info">分类：{{item.problemType}}</text>
        </view>

        <!-- 子区域和门牌号信息 -->
        <view class="record-subinfo-group" wx:if="{{item.subArea || item.doorNumber}}">
