<!--pages/PLANT_A_REPAIR/dispatcher/dispatcher.wxml-->
<view class="container">
  <!-- 顶部标题栏 -->
  <view class="header">
    <view class="header-content">
      <view class="header-title-section">
        <text class="greeting">管理员工作台</text>
        <text class="welcome">欢迎使用维修管理系统</text>
      </view>
      <view class="user-avatar">👤</view>
    </view>
  </view>

  <!-- 主功能区域 -->
  <view class="main-section">
    <!-- 核心功能卡片 -->
    <view class="main-card" bindtap="goToTaskAssign">
      <view class="card-gradient">
        <view class="card-header">
          <text class="card-title">任务分配中心</text>
          <text class="card-arrow">→</text>
        </view>
        <text class="card-description">分配、监控和管理所有维修任务</text>
        <!-- 修改card-stats部分 -->
        <view class="card-stats">
          <view class="stat-item">
            <text class="stat-number {{taskStats.pending > 0 ? 'highlight' : ''}}">{{taskStats.pending}}</text>
            <text class="stat-label">待分配</text>
          </view>
          <view class="stat-item">
            <text class="stat-number {{taskStats.assigned > 0 ? 'highlight-assigned' : ''}}">{{taskStats.assigned}}</text>
            <text class="stat-label">已分配</text>
          </view>
          <view class="stat-item">
            <text class="stat-number {{taskStats.inProgress > 0 ? 'highlight-progress' : ''}}">{{taskStats.inProgress}}</text>
            <text class="stat-label">进行中</text>
          </view>
          <view class="stat-item">
            <text class="stat-number">{{taskStats.completed}}</text>
            <text class="stat-label">已完成</text>
          </view>
          <!-- 新增：未完成任务统计 -->
          <view class="stat-item">
            <text class="stat-number {{taskStats.unfinished > 0 ? 'highlight-unfinished' : ''}}">{{taskStats.unfinished}}</text>
            <text class="stat-label">未完成</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 功能导航 -->
  <view class="nav-section">
    <view class="section-title">
      <view class="title-line"></view>
      <text class="title-text">常用功能</text>
      <view class="title-line"></view>
    </view>
    
    <view class="nav-grid">
      <view class="nav-item" bindtap="goToHistory">
        <view class="nav-icon history">📕</view>
        <text class="nav-name">维修记录</text>
        <text class="nav-desc">查看历史记录</text>
      </view>
      
      <view class="nav-item" bindtap="goToStatistics">
        <view class="nav-icon statistics">📊</view>
        <text class="nav-name">维修统计</text>
        <text class="nav-desc">数据分析统计</text>
      </view>
    </view>
  </view>

  <!-- 系统状态 -->
  <view class="status-section">
    <view class="status-card">
      <view class="status-header">
        <text class="status-title">系统状态</text>
        <text class="refresh-btn" bindtap="refreshData">↻ 刷新</text>
      </view>
      <view class="status-info">
        <view class="status-item">
          <view class="status-label">登录账号</view>
          <view class="status-value">{{userInfo.name || '分配员'}}</view>
        </view>
        <view class="status-item">
          <view class="status-label">登录时间</view>
          <view class="status-value">{{loginTime}}</view>
        </view>
        <!-- 修改状态区域的任务总数 -->
        <view class="status-item">
          <view class="status-label">任务总数</view>
          <view class="status-value">{{taskStats.pending + taskStats.assigned + taskStats.inProgress + taskStats.completed + taskStats.unfinished}}</view>
        </view>
        <view class="status-item">
          <view class="status-label">系统版本</view>
          <view class="status-value">V1.2.0</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="footer-actions">
    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>
</view>