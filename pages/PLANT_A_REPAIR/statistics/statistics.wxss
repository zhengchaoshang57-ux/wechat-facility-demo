/* pages/PLANT_A_REPAIR/statistics/statistics.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f6fa;
}

/* 头部样式 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: white;
  border-bottom: 1rpx solid #eee;
}

.header-left, .header-right {
  width: 120rpx;
}

.header-right {
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

.back-btn, .refresh-btn, .export-btn {
  font-size: 36rpx;
  color: #333;
  font-weight: bold;
}

.refresh-btn, .export-btn {
  font-size: 28rpx;
  margin-left: 20rpx;
}

.export-btn {
  color: #4CAF50;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.export-all-section {
  margin: 15rpx 20rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 12rpx;
  text-align: center;
  color: white;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0,3);
}

.export-all-text {
  font-size: 28rpx;
}

.refresh-btn {
  font-size: 28rpx;
  color: #007AFF;
}

/* 统计概览 */
.stats-overview {
  display: flex;
  justify-content: space-around;
  padding: 30rpx;
  background: white;
  margin: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
  flex-wrap: wrap;
}

.stat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 150rpx;
  margin: 10rpx 0;
}

.stat-number {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #666;
  text-align: center;
}

/* 标签页 */
.tabs {
  display: flex;
  background: white;
  margin: 0 20rpx;
  border-radius: 12rpx;
  padding: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s ease;
}

.tab.active {
  background: #007AFF;
  color: white;
  font-weight: bold;
}

/* 标签页内容 */
.tab-content {
  padding: 0 20rpx 20rpx;
}

/* 内容区域 */
.content-scroll {
  margin-bottom: 20rpx;
}

/* 分类区块 */
.category-section {
  background: white;
  margin: 20rpx 0;
  border-radius: 16rpx;
  padding: 25rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.section-count {
  font-size: 24rpx;
  color: #666;
}

/* 图表区块 */
.chart-section {
  margin-bottom: 25rpx;
}

.chart-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.chart-title text:first-child {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.chart-count {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-left: 15rpx;
  min-width: 40rpx;
  text-align: right;
}

/* 横向柱形图 */
.bar-chart {
  display: flex;
  align-items: center;
}

.bar-container {
  flex: 1;
  height: 35rpx;
  background-color: #f0f0f0;
  border-radius: 18rpx;
  overflow: hidden;
  position: relative;
}

.bar-fill {
  height: 100%;
  border-radius: 18rpx;
  transition: width 0.5s ease-in-out;
  min-width: 0;
}

/* 子区域样式 */
.sub-area-section {
  margin-bottom: 20rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  overflow: hidden;
}

.sub-area-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-bottom: 1rpx solid #e0e0e0;
}

.sub-area-title {
  display: flex;
  align-items: center;
  flex: 1;
}

.sub-area-icon {
  font-size: 24rpx;
  margin-right: 15rpx;
  color: #007AFF;
  font-weight: bold;
}

.sub-area-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.sub-area-total {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
  background: #e8f0fe;
  padding: 6rpx 12rpx;
  border-radius: 16rpx;
}

.sub-area-content {
  padding: 15rpx 20rpx;
  background-color: white;
}

.sub-area-chart-section {
  margin-bottom: 18rpx;
}

.sub-area-chart-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.sub-area-chart-title text:first-child {
  font-size: 24rpx;
  color: #555;
  flex: 1;
}

.sub-area-chart-count {
  font-size: 24rpx;
  font-weight: bold;
  color: #333;
  margin-left: 15rpx;
  min-width: 40rpx;
  text-align: right;
}