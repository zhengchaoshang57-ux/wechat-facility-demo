/* pages/PLANT_A_REPAIR/index/index.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  display: flex;
  justify-content: space-between;
  padding: 40rpx 30rpx;
  background: linear-gradient(135deg, #1a73e8, #6c8ef5);
  color: white;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
}

.header-title {
  text-align: center;
  flex: 1;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 6rpx;
}

.subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

.todo-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.todo-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.todo-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.todo-count {
  font-size: 28rpx;
  color: #ff6b35;
  background: #ffece5;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.todo-preview {
  margin-bottom: 30rpx;
}

.todo-preview-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.todo-item-text {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.todo-item-status {
  font-size: 24rpx;
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
}

.todo-item-status.pending {
  background: #ffece5;
  color: #ff6b35;
}

.todo-item-status.in-progress {
  background: #e8f0fe;
  color: #1a73e8;
}

.todo-item-status.pending_review {
  background: #fff8e6;
  color: #ff9800;
}

.todo-item-status.completed {
  background: #e7f7ed;
  color: #34a853;
}

.empty-preview {
  text-align: center;
  padding: 40rpx 0;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #ccc;
}

.jump-btn {
  background: linear-gradient(135deg, #1a73e8, #6c8ef5);
  color: white;
  border-radius: 50rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  width: 100%;
}

/* 功能操作区域 */
.action-container {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.action-card {
  background: white;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  text-align: center;
  transition: all 0.3s ease;
  border: 2rpx solid #e8f0fe;
}

.action-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  background: #f8faff;
}

.action-icon {
  font-size: 70rpx;
  margin-bottom: 20rpx;
}

.action-title {
  display: block;
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
  color: #333;
}

.action-desc {
  font-size: 26rpx;
  color: #666;
}

/* 快速操作区域 */
.quick-actions {
  display: flex;
  justify-content: center;
}

.action-btn {
  width: 100%;
  background: white;
  color: #1a73e8;
  border: 2rpx solid #1a73e8;
  border-radius: 50rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  transition: all 0.3s ease;
  margin-top: 20rpx;
}

.action-btn:active {
  background: #1a73e8;
  color: white;
}

/* 为返回登录按钮添加的样式 */
.logout-btn {
  color: #ff6b35;
  border-color: #ff6b35;
}

.logout-btn:active {
  background: #ff6b35;
  color: white;
}