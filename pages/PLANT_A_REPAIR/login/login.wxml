<!--pages/PLANT_A_REPAIR/login/login.wxml-->
<view class="login-container">
  <!-- 返回按钮 -->
  <view class="back-button" bindtap="goBack">
    <view class="back-icon">←</view>
    <text class="back-text">返回</text>
  </view>
  <!-- 背景装饰 -->
  <view class="background-decoration">
    <view class="decoration-circle circle-1"></view>
    <view class="decoration-circle circle-2"></view>
    <view class="decoration-circle circle-3"></view>
  </view>

  <!-- 顶部欢迎信息 -->
  <view class="welcome-section">
    <view class="app-logo">🔧</view>
    <text class="app-name">示例厂区A维修管理系统</text>
    <text class="welcome-text">请选择您的身份登录</text>
  </view>

  <!-- 用户角色选择 -->
  <view class="role-selection">
    <!-- 检查员 -->
    <view class="role-card" bindtap="loginAsAdmin">
      <view class="role-icon admin">👨‍💼</view>
      <text class="role-title">检查员</text>
      <text class="role-desc">常规巡视、发现问题、添加待办</text>
      <view class="role-features">
        <text class="feature-item">检查厂内问题</text>
        <text class="feature-item">提交待办事项</text>
        <text class="feature-item">编辑待办</text>
      </view>
    </view>
    <!-- 管理员 -->
    <view class="role-card" bindtap="loginAsDispatcher">
      <view class="role-icon dispatcher">👩‍💻</view>
      <text class="role-title">管理员</text>
      <text class="role-desc">审查待办、分配任务、统计数据</text>
      <view class="role-features">
        <text class="feature-item">分配待办事项</text>
        <text class="feature-item">统计维修数据</text>
        <text class="feature-item">生成图表</text>
      </view>
    </view>

    <!-- 维修员 -->
    <view class="role-card" bindtap="loginAsTechnician">
      <view class="role-icon technician">👨‍🔧</view>
      <text class="role-title">维修员</text>
      <text class="role-desc">执行维修、更新状态、提交报告</text>
      <view class="role-features">
        <text class="feature-item">接收维修任务</text>
        <text class="feature-item">更新任务状态</text>
        <text class="feature-item">提交完成报告</text>
      </view>
    </view>
  </view>

  <!-- 底部信息 -->
  <view class="footer">
    <text class="footer-text">选择对应身份进入系统</text>
    <text class="footer-hint">首次使用？系统将根据您的身份显示相应功能</text>
  </view>
</view>
