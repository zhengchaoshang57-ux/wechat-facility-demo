<!--pages/PLANT_A_CLEANING/create-todo/create-todo.wxml-->
<view class="container">
  <!-- 顶部标题栏 -->
  <view class="header">
    <view class="header-content">
      <view class="header-left">
        <text class="back-btn" bindtap="goBack">←</text>
      </view>
      <view class="header-title-section">
        <text class="header-title">新建待办</text>
        <text class="header-subtitle">请填写待办事项详情</text>
      </view>
      <view class="header-right">
        <text class="save-btn" bindtap="saveTodo">保存</text>
      </view>
    </view>
  </view>

  <!-- 表单主区域 -->
  <scroll-view class="form-container" scroll-y="true">
    <!-- 基本信息卡片 -->
    <view class="form-card">
      <view class="card-header">
        <text class="card-title">基本信息</text>
        <view class="card-line"></view>
      </view>

      <!-- 表单内容 -->
      <view class="form-content">
        <!-- 标题 -->
        <view class="form-group">
          <text class="form-label">标题</text>
          <input class="form-input" 
                 placeholder="请输入待办事项标题" 
                 placeholder-class="placeholder"
                 value="{{title}}"
                 bindinput="onTitleInput" />
        </view>

        <!-- 来源 -->
        <view class="form-group">
          <text class="form-label">来源</text>
          <picker mode="selector"
                  range="{{sourceOptions}}"
                  value="{{sourceIndex}}"
                  bindchange="onSourceChange">
                  <view class="form-picker">
              <text class="{{sourceOptions[sourceIndex] ? 'picker-text' : 'picker-placeholder'}}">
                {{sourceOptions[sourceIndex] || '请选择来源'}}
              </text>
              <text class="picker-icon">▼</text>
            </view>
          </picker>
        </view>

        <!-- 问题区域 -->
        <view class="form-group">
          <text class="form-label">问题区域</text>
          <picker mode="selector"
                  range="{{areaOptions}}"
                  value="{{areaIndex}}"
                  bindchange="onAreaChange">
                  <view class="form-picker">
              <text class="{{areaOptions[areaIndex] ? 'picker-text' : 'picker-placeholder'}}">
                {{areaOptions[areaIndex] || '请选择问题区域'}}
              </text>
              <text class="picker-icon">▼</text>
            </view>
          </picker>
        </view>

        <!-- 其他区域描述 -->
        <view class="form-group" wx:if="{{showOtherAreaInput}}">
          <text class="form-label">其他区域描述</text>
          <input class="form-input"
                 placeholder="请输入其他区域描述"
                 placeholder-class="placeholder"
                 value="{{otherAreaDescription}}"
                 bindinput="onOtherAreaDescriptionInput" />
        </view>

        <!-- 动态子区域 -->
        <view class="form-group" wx:if="{{showSubArea}}">
          <text class="form-label">{{problemArea}}</text>
          <picker mode="selector"
                  range="{{subAreaOptions}}"
                  value="{{subAreaIndex}}"
                  bindchange="onSubAreaChange">
            <view class="form-picker">
              <text class="{{subAreaOptions[subAreaIndex] ? 'picker-text' : 'picker-placeholder'}}">
                {{subAreaOptions[subAreaIndex] || '请选择' + problemArea}}
              </text>
              <text class="picker-icon">▼</text>
            </view>
          </picker>
        </view>

        <!-- 其他子区域描述 -->
        <view class="form-group" wx:if="{{showOtherSubAreaInput}}">
          <text class="form-label">其他具体位置</text>
          <input class="form-input"
                 placeholder="请输入其他具体位置描述"
                 placeholder-class="placeholder"
                 value="{{otherSubAreaDescription}}"
                 bindinput="onOtherSubAreaDescriptionInput" />
        </view>

        <!-- 问题 -->
        <view class="form-group">
          <text class="form-label">问题</text>
          <picker mode="selector"
                  range="{{problemOptions}}"
                  value="{{problemIndex}}"
                  bindchange="onProblemChange">
            <view class="form-picker">
              <text class="{{problemOptions[problemIndex] ? 'picker-text' : 'picker-placeholder'}}">
                {{problemOptions[problemIndex] || '请选择问题'}}
              </text>
              <text class="picker-icon">▼</text>
            </view>
          </picker>
        </view>

        <!-- 门牌号 -->
        <view class="form-group" wx:if="{{showDoorInput}}">
          <text class="form-label">门牌号/具体位置</text>
          <view class="form-tips">若无门牌号，请写明具体位置</view>
          <input class="form-input"
                 placeholder="请输入门牌号或具体位置"
                 placeholder-class="placeholder"
                 value="{{doorNumber}}"
                 bindinput="onDoorNumberInput" />
        </view>
      </view>
    </view>

    <!-- 问题分类卡片 -->
    <view class="form-card">
      <view class="card-header">
        <text class="card-title">问题分类</text>
        <view class="card-line"></view>
      </view>
      <view class="form-content">
        <view class="form-group">
          <view class="problem-type-group">
            <block wx:for="{{problemTypeOptions}}" wx:key="index">
              <view
                class="problem-type-item {{problemTypeIndex === index ? 'active' : ''}}"
                bindtap="setProblemType"
                data-index="{{index}}"
                data-value="{{item}}">
                <text class="problem-type-text">{{item}}</text>
              </view>
            </block>
          </view>
          <view class="form-tips" wx:if="{{problemType}}">
            <text class="tips-text">已选择：{{problemType}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 图片上传卡片 -->
    <view class="form-card">
      <view class="card-header">
        <text class="card-title">图片描述</text>
        <view class="card-line"></view>
      </view>
      <view class="form-content">
        <view class="image-upload">
          <view class="upload-tips">最多可上传3张图片</view>
          <view class="image-list">
            <!-- 已上传的图片 -->
            <block wx:for="{{images}}" wx:key="index">
              <view class="image-item" bindtap="previewImage" data-index="{{index}}">
                <image class="image" src="{{item}}" mode="aspectFill"></image>
                <view class="delete-btn" bindtap="deleteImage" data-index="{{index}}" catchtap="stopPropagation">×</view>
              </view>
            </block>
            <!-- 上传按钮 -->
            <view class="upload-btn" bindtap="chooseImage" wx:if="{{images.length < 3}}">
              <text class="upload-icon">+</text>
              <text class="upload-text">添加图片</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 详细信息卡片 -->
    <view class="form-card">
      <view class="card-header">
        <text class="card-title">详细信息</text>
        <view class="card-line"></view>
      </view>
      <view class="form-content">
        <!-- 描述 -->
        <view class="form-group">
          <text class="form-label">描述</text>
          <textarea class="form-textarea" 
                    placeholder="请输入待办事项描述"
                    placeholder-class="placeholder"
                    value="{{description}}"
                    bindinput="onDescriptionInput" />
        </view>

        <!-- 创建时间 -->
        <view class="form-group">
          <text class="form-label">创建时间</text>
          <view class="create-time-display">
            <text class="create-time-icon">📅</text>
            <text class="create-time-text">{{createTime}}</text>
          </view>
        </view>

        <!-- 创建人 -->
        <view class="form-group">
          <text class="form-label">创建人</text>
          <input class="form-input" 
                 placeholder="请输入创建人姓名"
                 placeholder-class="placeholder"
                 value="{{creator}}"
                 bindinput="onCreatorInput" />
        </view>
      </view>
    </view>

    <!-- 底部空间 -->
    <view class="footer-space"></view>
  </scroll-view>

  <!-- 底部保存按钮 -->
  <view class="footer-actions">
    <button class="save-btn-large" bindtap="saveTodo">保存待办</button>
  </view>
</view>